    <node reference="N1174790">
      <layout x="32340" y="50401" height="3960" width="3960" />
      <type>2</type>
      <user-id><![CDATA[N1174790]]></user-id>
      <user-title><![CDATA[By restricting the module to documented NMEA or UBX protocols and disabling 'Proprietary' or 'Engineering' modes, we ensure the data stream is transparent and lacks the 'overhead' required for steganographic exfiltration.]]></user-title>
      <status-fields>
        <status-field type="string" name="annotation"><![CDATA[]]></status-field>
        <status-field type="string" name="audited"><![CDATA[]]></status-field>
