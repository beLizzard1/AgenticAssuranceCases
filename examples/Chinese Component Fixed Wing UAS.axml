    <node reference="N81503312">
      <layout x="55020" y="50401" height="3960" width="3960" />
      <type>2</type>
      <user-id><![CDATA[N81503312]]></user-id>
      <user-title><![CDATA[By implementing a Hardware Root of Trust (Secure Boot), the module validates the firmware hash at every power-on, ensuring that any silent 'bit-rot' or tampering results in a fail-safe (system halt) rather than execution.]]></user-title>
      <status-fields>
        <status-field type="string" name="annotation"><![CDATA[]]></status-field>
        <status-field type="string" name="audited"><![CDATA[]]></status-field>
