				</hotspot>
				<hotspot>
					<key>south</key>
					<x>0.5</x>
					<y>1</y>
				</hotspot>
				<hotspot>
					<key>west</key>
					<x>0</x>
					<y>0.5</y>
				</hotspot>
			</hotspots>
		</nodetype>
		<!--evidence-->
		<nodetype>
			<key>evidence</key>
			<displaytext>Evidence</displaytext>
			<baseshape>1</baseshape>
			<basecolour>#6446A6</basecolour>
			<defaultlinktype>3</defaultlinktype>
			<aspectratio>0</aspectratio>
			<hotspots>
				<hotspot>
					<key>north</key>
					<x>0.5</x>
					<y>0</y>
				</hotspot>
				<hotspot>
					<key>east</key>
