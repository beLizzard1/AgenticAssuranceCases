<?xml version="1.0" encoding="ISO-8859-1"?>
<asceschema>
	<name>ASCAD</name>
	<author>Adelard</author>
    <version>2.0</version>
	<requiresasceversion>5.1.0</requiresasceversion>
    <description>The ASCAD definition that includes claims, arguments and evidence, simple status fields and basic structure checking. It also includes defeaters, sub-cases, new link types and colours for schema elements.
		This schema should not be modified without due consideration to existing content that has been created in this schema. The ASCAD schema is copyright Adelard 2022.
	</description>
	<behaviours>
		<canmultilink>False</canmultilink>
		<canreflexlink>False</canreflexlink>
	</behaviours>
	<nodetypes>
		<!--claim-->
		<nodetype>
			<key>claim</key>
			<displaytext>Claim</displaytext>
			<baseshape>0</baseshape>
			<basecolour>#29A7D9</basecolour>
			<defaultlinktype>1</defaultlinktype>
			<aspectratio>0</aspectratio>
			<hotspots>
				<hotspot>
					<key>north</key>
					<x>0.5</x>
					<y>0</y>
				</hotspot>
				<hotspot>
					<key>east</key>
					<x>1</x>
					<y>0.5</y>
				</hotspot>
				<hotspot>
					<key>south</key>
					<x>0.5</x>
					<y>1</y>
				</hotspot>
				<hotspot>
					<key>west</key>
					<x>0</x>
					<y>0.5</y>
				</hotspot>
			</hotspots>
		</nodetype>
		<!--argument-->
		<nodetype>
			<key>argument</key>
			<displaytext>Argument</displaytext>
			<baseshape>2</baseshape>
			<basecolour>#68BF50</basecolour>
			<defaultlinktype>2</defaultlinktype>
			<aspectratio>0</aspectratio>
			<hotspots>
