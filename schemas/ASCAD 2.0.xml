			</hotspots>
		</nodetype>
		<!--side-claim-->
		<nodetype>
			<key>side-claim</key>
			<displaytext>Side-claim</displaytext>
			<baseshape>0</baseshape>
			<basecolour>#F29D35</basecolour>
			<defaultlinktype>4</defaultlinktype>
			<aspectratio>0</aspectratio>
			<hotspots>
				<hotspot>
					<key>north</key>
					<x>0.5</x>
					<y>0</y>
				</hotspot>
				<hotspot>
					<key>east</key>
					<x>1</x>
					<y>0.5</y>
				</hotspot>
				<hotspot>
					<key>south</key>
					<x>0.5</x>
					<y>1</y>
				</hotspot>
				<hotspot>
					<key>west</key>
					<x>0</x>
					<y>0.5</y>
				</hotspot>
			</hotspots>
		</nodetype>
		<!--sub-case-->
		<nodetype>
			<key>subcase</key>
			<displaytext>Sub-case</displaytext>
			<baseshape>1</baseshape>
			<basecolour>#6446A6</basecolour>
			<defaultlinktype>3</defaultlinktype>
			<aspectratio>0</aspectratio>
			<hotspots>
				<hotspot>
					<key>north</key>
					<x>0.5</x>
					<y>0</y>
				</hotspot>
				<hotspot>
					<key>east</key>
					<x>1</x>
					<y>0.5</y>
				</hotspot>
				<hotspot>
					<key>south</key>
