				</hotspot>
				<hotspot>
					<key>west</key>
					<x>0</x>
					<y>0.5</y>
				</hotspot>
			</hotspots>
		</nodetype>
		<!--other-->
		<nodetype>
			<key>other</key>
			<displaytext>Other</displaytext>
			<baseshape>8</baseshape>
			<basecolour>#a0a0a0</basecolour>
			<defaultlinktype>2</defaultlinktype>
			<aspectratio>0</aspectratio>
			<hotspots>
				<hotspot>
					<key>north</key>
					<x>0.5</x>
					<y>0.1</y>
				</hotspot>
				<hotspot>
					<key>east</key>
					<x>1</x>
					<y>0.5</y>
				</hotspot>
				<hotspot>
					<key>south</key>
					<x>0.5</x>
					<y>0.9</y>
				</hotspot>
				<hotspot>
					<key>west</key>
					<x>0</x>
					<y>0.5</y>
				</hotspot>
			</hotspots>
		</nodetype>
		<!--caption-->
		<nodetype>
			<key>caption</key>
			<displaytext>Caption</displaytext>
			<baseshape>1</baseshape>
			<basecolour>#808080</basecolour>
			<defaultlinktype>2</defaultlinktype>
			<aspectratio>0</aspectratio>
			<hotspots>
				<hotspot>
					<key>north</key>
					<x>0.5</x>
					<y>0</y>
				</hotspot>
				<hotspot>
					<key>east</key>
					<x>1</x>
					<y>0.5</y>
				</hotspot>
				<hotspot>
					<key>south</key>
